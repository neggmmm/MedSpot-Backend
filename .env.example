PORT=8000
FRONTEND_URI=http://localhost:3000

# Local PostgreSQL. Alternatively, set DATABASE_URL and omit the five split values.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nest_market
DATABASE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Replace all change-me values before using the related integration.
JWT_SECRET_KEY=change-me-use-a-long-random-secret

AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_KEY=change-me
AWS_REGION=eu-north-1
AWS_S3_BUCKET=change-me
AWS_S3_PRODUCTS_PREFIX=products
AWS_S3_USERS_PREFIX=users

PAYMOB_API_KEY=change-me
PAYMOB_INTEGRATION_ID=change-me
PAYMOB_IFRAME_ID=change-me
PAYMOB_HMAC_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=change-me
MAIL_PASS=change-me
MAIL_FROM=no-reply@example.com
